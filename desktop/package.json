{
  "name": "nexus-desktop",
  "version": "0.1.0",
  "description": "Nexus 多智能体研发助手 — 桌面客户端",
  "author": "Raine <contact@rainea.dev>",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:server": "node scripts/build-server.mjs",
    "build": "node scripts/build.mjs",
    "dist": "node scripts/build.mjs",
    "dist:win": "node scripts/build.mjs --win",
    "dist:mac": "node scripts/build.mjs --mac",
    "dist:linux": "node scripts/build.mjs --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.rainea.nexus",
    "productName": "Nexus",
    "copyright": "Copyright © 2024 Raine",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "server",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "out"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus"
    }
  }
}
